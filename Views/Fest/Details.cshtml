@model Participant

<h2>Participant Details</h2>

<div class="alert alert-success">

    <h4>
        Welcome, @Model.ParticipantName!
    </h4>

    <p>
        You are registered 
        <b>@Model.EventName</b>.
    </p>

</div>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.ParticipantId</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.ParticipantName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Department</th>
        <td>@Model.Department</td>
    </tr>

    <tr>
        <th>Year</th>
        <td>@Model.Year</td>
    </tr>

    <tr>
        <th>Event</th>
        <td>@Model.EventName</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.GetRegistrationStatus()</td>
    </tr>

    <tr>
        <th>Fee Category</th>
        <td>@Model.GetFeeCategory()</td>
    </tr>

</table>

<a asp-action="Index"
   class="btn btn-primary">
    Back
</a>