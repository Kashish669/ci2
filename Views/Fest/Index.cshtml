@* using CIE_1.Extensions; *@
@model List<Participant>


<h2>Technical Fest Register</h2>

<a asp-action="Register" class="btn btn-primary">
    Register
</a>

<a asp-action="Welcome" class="btn btn-info">
    Welcome
</a>

<br /><br />

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Department</th>
        <th>Year</th>
        <th>Event</th>
        <th>Status</th>
        <th>Fee Category</th>
        <th>Action</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ParticipantId</td>
            <td>@p.ParticipantName</td>
            <td>@p.Email</td>
            <td>@p.Department</td>
            <td>@p.Year</td>
            <td>@p.EventName</td>

            <td>
                @p.GetRegistrationStatus()
            </td>

            <td>
                @p.GetFeeCategory()
            </td>

            <td>
                <a asp-action="Details"
                   asp-route-id="@p.ParticipantId"
                   class="btn btn-success">
                    Details
                </a>
            </td>
        </tr>
    }

</table>